# =====================================================================================
# autoLP environment — copy to `.env` and fill in. `.env` is git-ignored. NEVER commit secrets.
# One file is shared by Foundry (deploy/fork tests) and the TypeScript keeper.
# =====================================================================================

# ---- Network ------------------------------------------------------------------------
# base-sepolia (default, testnet) | base-mainnet (REFUSED unless ALLOW_MAINNET_KEEPER=true)
NETWORK=base-sepolia

# ---- Infura -------------------------------------------------------------------------
# Your Infura project API key (https://app.infura.io -> API Keys). Make sure the Base
# network (mainnet and/or sepolia) is enabled for that key.
INFURA_API_KEY=
# Optional: full RPC URL override (any provider, local anvil/hardhat). Takes precedence over Infura.
RPC_URL=

# Used by Foundry (foundry.toml [rpc_endpoints]) for deploy scripts and fork tests.
# Fill in with your Infura key, e.g. https://base-sepolia.infura.io/v3/<INFURA_API_KEY>
BASE_MAINNET_RPC_URL=https://base-mainnet.infura.io/v3/<INFURA_API_KEY>
BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/<INFURA_API_KEY>
# Pinned block for reproducible fork tests (needs an archive-capable RPC for old blocks)
FORK_BLOCK=53360000

# ---- Wallets (use TWO DIFFERENT wallets) ---------------------------------------------
# 1) DEPLOYER: only needed to run `forge script script/Deploy.s.sol`. Needs a little ETH for gas on the target network.
#    In production the OWNER should be a multisig; the deployer key can then be discarded.
DEPLOYER_PRIVATE_KEY=
# Address that will own the contract (admin: config, pause, withdraw). Ownable2Step: it must call acceptOwnership().
OWNER_ADDRESS=

# 2) KEEPER: a dedicated hot wallet that ONLY pays gas for executeStrategy(). Fund it with a small amount of ETH.
#    It has no admin rights and cannot withdraw funds. Never reuse the owner/deployer key here.
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

# ---- Deployed contract ---------------------------------------------------------------
LIQUIDITY_MANAGER_ADDRESS=
# Fee tier used at deployment: 500 (0.05%) or 3000 (0.30%)
FEE_TIER=500
# Minimum position value (raw USDC, 6 decimals) below which the contract does nothing. Default 1000e6 = 1,000 USDC.
# For a ~100 EUR test, uncomment and use e.g. 50000000 (50 USDC). Left commented => default.
# MIN_POSITION_VALUE_USDC=50000000

# ---- Optional "stay out of the market" rules (docs/DECISIONS.md D-18; OFF unless set) --------
# LP is closed (tokens held at FLAT_WETH_BPS of value in WETH) during the UTC hours whose bit is set:
# 13:00-17:00 UTC (US open) = 2^13+2^14+2^15+2^16 = 122880. Weekdays only unless QUIET_WEEKDAYS_ONLY=false.
# QUIET_HOURS_MASK=122880
# QUIET_WEEKDAYS_ONLY=true
# Close the LP when 24h realised volatility (annualised, bps) reaches EXIT, re-open when it falls to ENTER (hysteresis).
# VOL_EXIT_BPS=5000
# VOL_ENTER_BPS=4000
# VOL_WINDOW_SECONDS=86400
# VOL_SAMPLES=24
# FLAT_WETH_BPS=5000

# ---- Keeper tuning (all optional) ------------------------------------------------------
POLL_INTERVAL_MS=30000
# Defer sending if the network fee is above this (gwei) or the estimated tx cost above this (ETH)
MAX_GAS_PRICE_GWEI=5
MAX_TX_COST_ETH=0.005
# Alert when the keeper wallet balance drops below this (ETH)
MIN_KEEPER_BALANCE_ETH=0.005
MAX_READ_RETRIES=3
PENDING_TX_TIMEOUT_MS=180000
MAX_CONSECUTIVE_FAILURES=3
FAILURE_COOLDOWN_MS=600000
HEARTBEAT_EVERY_POLLS=120
LOG_LEVEL=info
# Slack/Discord-compatible webhook for alerts (paused, repeated failures, stuck tx, low balance)
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MS=3600000
# Prometheus-style metrics on 127.0.0.1:<port> (0 = disabled)
METRICS_PORT=0

# ---- Safety switches (leave unset) -----------------------------------------------------
# ALLOW_MAINNET_DEPLOY=true   # script/Deploy.s.sol refuses Base Mainnet unless this is set. DO NOT set before an audit.
# ALLOW_MAINNET_KEEPER=true   # keeper refuses Base Mainnet unless this is set. DO NOT set before an audit.
